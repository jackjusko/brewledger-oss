# BrewLedger — environment variables
# Copy to .env in the repo root and fill in values as needed.
# Core features work without Stripe, QBO, SES, or OpenRouter.

# --- Server ---
PORT=3000
HOST=0.0.0.0
DB_PATH=./server/database.sqlite
STATIC_DIR=./platforms/console/dist

# Password reset and invite email links (console app URL)
RESET_BASE_URL=http://localhost:5174/reset
API_BASE_URL=http://localhost:3000

# Optional: HTTPS (leave empty for local HTTP)
TLS_KEY_PATH=
TLS_CERT_PATH=

# Testing only — allows login with any user email + this password. Leave empty in production.
MASTER_PASSWORD=

# --- Stripe (optional — billing returns 503 when unset) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
APP_DEEP_LINK_SCHEME=brewledger
BILLING_RETURN_BASE_URL=http://localhost:5174

# --- AWS SES (optional — email not sent when unset) ---
AWS_SES_REGION=
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=

# --- QuickBooks Online (optional) ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/integrations/qbo/callback
QBO_AUTH_URL=https://appcenter.intuit.com/connect/oauth2
QBO_TOKEN_URL=https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer
QBO_API_BASE_URL=https://sandbox-quickbooks.api.intuit.com

# --- OpenRouter AI assistant (optional) ---
OPENROUTER_API_KEY=
OPENROUTER_PRESET=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_HTTP_REFERER=http://localhost:5174
OPENROUTER_X_TITLE=BrewLedger Console
OPENROUTER_PRESET_CSV=

# --- CSV item processor script (optional) ---
BRAVE_SEARCH_API_KEY=
ENABLE_WEB_SEARCH=false

# --- Contact form (optional � landing page demo requests via Discord) ---
DISCORD_WEBHOOK_URL=

# --- Admin scripts only (check_stripe.cjs, create_portal_config.cjs) ---
# STRIPE_PRODUCT_IDS=prod_xxx,prod_yyy
# STRIPE_PORTAL_PRODUCTS_JSON=[{"product":"prod_xxx","prices":["price_xxx"]}]

# --- Console (Vite) — set in platforms/console/.env.local or shell ---
# VITE_API_BASE_URL=http://localhost:3000/api
# VITE_SITE_BASE_URL=http://localhost:5174
# VITE_PROXY_TARGET=http://localhost:3000
# VITE_CONTACT_EMAIL=support@example.com

# --- Mobile app (Vite) ---
# VITE_API_BASE_URL=http://localhost:3000/api
# VITE_CONSOLE_BASE_URL=http://localhost:5174
