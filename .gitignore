# Dependencies
node_modules/

# Environment and secrets (API keys, Stripe, DB paths)
.env
.env.local
.env.*.local

# Build output
dist/
build/
www/

# Database (SQLite – created at runtime; don’t commit)
*.db
*.sqlite
*.sqlite3

# Logs and debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test and coverage
coverage/
.nyc_output/

# OS files
.DS_Store
Thumbs.db

# IDE (remove .vscode/ if you want to share workspace settings)
.idea/
.vscode/
*.swp
*.swo

# Capacitor / native build artifacts
platforms/brewledger-app/android/.gradle/
platforms/brewledger-app/android/app/build/
platforms/brewledger-app/ios/App/Pods/
platforms/brewledger-app/ios/App/build/
platforms/brewledger-app/ios/App/App/public/
platforms/brewledger-app/ios/DerivedData/

# Internal dev (private repo; excluded from public export)
changes/
.cursor/
.letta/

# Export staging (generated by scripts/prepare-oss-export.ps1)
oss-export/

# Local env (never commit)
.env
.env.*
!.env.example
